{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hawk T1 Flight Checklist",
  "version": "1.0.0",
  "identifier": "com.hawkt1.flightchecklist",
  "build": {
    "frontendDist": "."
  },
  "app": {
    "windows": [
      {
        "title": "HAWK T1 — Flight Checklist",
        "width": 1200,
        "height": 900,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    }
  }
}
